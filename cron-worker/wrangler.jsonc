{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "india-kitsch-cron",
  "main": "src/index.ts",
  // Capped to what the locally installed workerd binary supports (`wrangler
  // dev` runs against it directly); harmless to be a couple of days behind
  // — bump anytime, it only gates opting into newer default behaviors.
  "compatibility_date": "2026-09-21",

  // Daily keep-alive/backup-freshness, plus the 10-minute payment
  // reconciler added in Phase 6 (docs/06 §9 step 7, docs/08 §18) — the
  // `scheduled()` handler in src/index.ts tells the two apart via
  // `event.cron`. Pick whatever time suits for the daily one; nothing
  // there is time-sensitive.
  "triggers": {
    "crons": ["0 0 * * *", "*/10 * * * *"],
  },

  // The deployed Next app's base URL — not a secret, just where the
  // reconciler POSTs. PLACEHOLDER: no production domain is decided yet
  // (docs/01 §1 etc. still say `<domain>` throughout) — this must be set
  // to the real Vercel/custom domain before the 10-minute trigger can
  // actually reach anything. Override locally via .dev.vars if it differs.
  "vars": {
    "APP_URL": "https://REPLACE_WITH_REAL_DOMAIN.example",
    // Set to "on" at customer handover, when backup.yml is re-enabled (docs/08 §16).
    "BACKUP_FRESHNESS_CHECK": "off",
  },

  // SUPABASE_URL / SUPABASE_ANON_KEY / CRON_SECRET are set via `wrangler
  // secret put` for the deployed Worker, and via .dev.vars (gitignored,
  // see .dev.vars.example) for local `wrangler dev`. Not committed here
  // even though the anon key is "public by design" (docs/08 §19) — same
  // discipline as the Next.js app's own .env.local.
  "observability": {
    "enabled": true,
  },

  // Read-only use: listing the backups/ prefix to check freshness
  // (docs/08 §16, §18). Reuses the same bucket scripts/backup-db.ts
  // writes to — see the TODO there about splitting into a dedicated
  // bucket before production.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "india-kitsch-staging",
    },
  ],
}
