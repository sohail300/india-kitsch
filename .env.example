# Copy to .env.local and fill in real values. .env.local is gitignored.
# See docs/08-infrastructure-backups-ops.md §19 for what each var is and
# where it's set in each environment (local / Preview / Production).

# --- Database (Supabase) ---------------------------------------------------
# App runtime: the TRANSACTION pooler connection string (port 6543).
DATABASE_URL="postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# CI only (migrations, pg_dump): the SESSION pooler connection string (port 5432).
# Not read by the Next app — only used by drizzle-kit / backup scripts locally and in CI.
DATABASE_URL_SESSION="postgres://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth (Better Auth) ------------------------------------------------------
BETTER_AUTH_SECRET="generate-a-random-32+-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Payments (Razorpay test keys locally / in Preview) ---------------------
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Site / public config ----------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_IMAGE_BASE_URL="http://localhost:3000/images"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"
CONTACT_INBOX_EMAIL="hello@example.com"

# --- Files (Cloudflare R2) -----------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ik-images-dev"

# --- Cron (shared secret with the Cloudflare cron Worker) ----------------------
CRON_SECRET="generate-a-random-16+-char-secret"

# --- Monitoring (optional until Phase 7) ----------------------------------------
SENTRY_DSN=""
